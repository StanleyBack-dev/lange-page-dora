# =====================================================================
# Dora — Landing page
# Copy to `.env.local` (dev). In production set these on Vercel.
# NEVER commit real values.
# =====================================================================

# === SITE ===
# Public address of the landing page (canonical URLs, sitemap, og:image).
SITE_URL=http://localhost:3001
# The Dora app ("Entrar" button).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === BACKEND (backend-dora: contact form and analytics live in its
# `landing` module; e-mails go through its Brevo account) ===
BACKEND_URL=http://localhost:4000
# Same value as the backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=

# === CONTACT FORM PROTECTION ===
# HMAC key of the form token (time trap against bots). 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_FORM_SECRET=
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget, with the
# site domain). Both empty = no challenge (local dev only). Test keys that
# always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === CONTACTS (public; a channel left empty is hidden) ===
# Digits only, with country and area code, e.g. 5511999999999.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=suporte.doragestao@gmail.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# === DEV ONLY ===
# `next dev`: LAN addresses allowed to load the page scripts, e.g. to open
# it on a phone on the same Wi-Fi (http://192.168.x.x:3001).
DEV_ALLOWED_ORIGINS=

# === SEARCH ENGINES (optional) ===
# Google Search Console "HTML tag" verification code.
GOOGLE_SITE_VERIFICATION=
